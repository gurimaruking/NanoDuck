    <mesh name="noenoeil" file="noenoeil.stl" scale="0.8500 0.8500 0.8500"/>
    <mesh name="left_shell" file="left_shell.stl" scale="0.8500 0.8500 0.8500"/>
    <mesh name="right_shell" file="right_shell.stl" scale="0.8500 0.8500 0.8500"/>
    <mesh name="sole_left" file="sole_left.stl" scale="0.7500 0.7500 0.7500"/>
    <mesh name="sole_right" file="sole_right.stl" scale="0.7500 0.7500 0.7500"/>
    <mesh name="hip_yoke_L" file="../print/hip_yoke_L.stl" scale="0.001 0.001 0.001"/>
    <mesh name="hip_yoke_R" file="../print/hip_yoke_R.stl" scale="0.001 0.001 0.001"/>
    <mesh name="thigh_L" file="../print/thigh_L.stl" scale="0.001 0.001 0.001"/>
    <mesh name="thigh_R" file="../print/thigh_R.stl" scale="0.001 0.001 0.001"/>
    <mesh name="shin_L" file="../print/shin_L.stl" scale="0.001 0.001 0.001"/>
    <mesh name="shin_R" file="../print/shin_R.stl" scale="0.001 0.001 0.001"/>
    <mesh name="foot_mount_L" file="../print/foot_mount_L.stl" scale="0.001 0.001 0.001"/>
    <mesh name="foot_mount_R" file="../print/foot_mount_R.stl" scale="0.001 0.001 0.001"/>
    <mesh name="neck_link" file="../print/neck_link.stl" scale="0.001 0.001 0.001"/>
  </asset>

