<mujoco model="nanoduck">
  <compiler angle="radian" autolimits="true" meshdir="../cad/microduck_src"/>
  <option timestep="0.005" iterations="10" ls_iterations="10"/>

  <default>
    <!-- Only the soles collide, as in MicroDuck robot_walk.xml: falling is
         cheap during velocity training and the contacts cost solver time. -->
    <default class="viz">
      <geom contype="0" conaffinity="0" group="3"/>
    </default>
    <!-- The cosmetic shells: MicroDuck's own geometry, visual only.
         Group 2, so a renderer can show the skin and hide the boxes. -->
    <default class="skin">
      <geom type="mesh" mass="0" contype="0" conaffinity="0" group="2" rgba="0.96 0.94 0.88 1"/>
    </default>
    <default class="collision">
      <geom contype="1" conaffinity="1" group="3" condim="3" friction="1.0 0.005 0.0001"/>
    </default>
    <!-- Position gains are the MG90S/MG92B closed-loop stiffness. They are
         overwritten anyway when sim/mg90s.py ServoBank.install() takes over,
         but they make the bare model behave sensibly on its own. -->
    <joint damping="0.005" frictionloss="0.012" armature="0.003"/>
  </default>

  <asset>
    <mesh name="bottom_head_shell" file="bottom_head_shell.stl" scale="0.8500 0.8500 0.8500"/>
    <mesh name="top_head_shell" file="top_head_shell.stl" scale="0.8500 0.8500 0.8500"/>
    <mesh name="face_part" file="face_part.stl" scale="0.8500 0.8500 0.8500"/>
